# 1. Користувач натискає кнопку завантаження файлу
@dp.message(F.text == "📁 Надіслати документ")
async def start_file_upload(message: types.Message, state: FSMContext):
    await state.set_state(FormStates.waiting_for_file)
    await message.answer(
        "Будь ласка, надішліть файл (як документ або фото). "
        "Я збережу його на сервері.",
        reply_markup=cancel_menu
    )


# 2. Обробник, якщо користувач надіслав файл як "Документ" (без стиснення: pdf, docx, xlsx, zip тощо)
@dp.message(FormStates.waiting_for_file, F.document)
async def download_document(message: types.Message, state: FSMContext):
    document = message.document
    file_name = document.file_name or f"file_{document.file_unique_id}"

    # Створюємо унікальний шлях, щоб файли з однаковими назвами не перезаписували один одного
    file_path = os.path.join(DOWNLOADS_DIR, f"{message.from_user.id}_{file_name}")

    # Отримуємо інформацію про файл від Telegram
    file_info = await bot.get_file(document.file_id)

    # Завантажуємо файл на сервер
    await bot.download_file(file_info.file_path, destination=file_path)

    await state.clear()  # Завершуємо стан
    await message.answer(f"✅ Файл '{file_name}' успішно завантажено!", reply_markup=main_menu)
    print(f"[ФАЙЛ ЗАВАНТАЖЕНО] Збережено у: {file_path}")


# 3. Обробник, якщо користувач надіслав файл як звичайне "Фото" (із стисненням Telegram)
@dp.message(FormStates.waiting_for_file, F.photo)
async def download_photo(message: types.Message, state: FSMContext):
    # Telegram створює кілька копій фото різного розміру, беремо найбільшу (останню в списку)
    photo = message.photo[-1]

    file_path = os.path.join(DOWNLOADS_DIR, f"{message.from_user.id}_{photo.file_unique_id}.jpg")
    file_info = await bot.get_file(photo.file_id)

    await bot.download_file(file_info.file_path, destination=file_path)

    await state.clear()
    await message.answer("✅ Фотографію успішно завантажено!", reply_markup=main_menu)
    print(f"[ФОТО ЗАВАНТАЖЕНО] Збережено у: {file_path}")


